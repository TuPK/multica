---
import Base from "../layouts/Base.astro";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Ecosystem from "../components/Ecosystem.astro";
import Software from "../components/Software.astro";
import GetStarted from "../components/GetStarted.astro";
import Problem from "../components/Problem.astro";
import Scenario from "../components/Scenario.astro";
import Mechanics from "../components/Mechanics.astro";
import Industries from "../components/Industries.astro";
import TeamSlider from "../components/TeamSlider.astro";
import Process from "../components/Process.astro";
import Audience from "../components/Audience.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";

const title = "AI Agent Company: công ty số với nhân viên là AI agent";
const description =
  "Biến tài khoản AI bạn đang có thành đội nhân viên chuyên theo ngành: tự nhận việc, chuyển việc cho nhau, chỉ dừng ở bước cần bạn duyệt. Cho cá nhân và doanh nghiệp.";
---

<Base title={title} description={description}>
  <IconSprite />
  <Header />
  <main>
    <Hero />
    <Problem />
    <Industries />
    <Ecosystem />
    <Scenario />
    <Software />
    <Mechanics />
    <TeamSlider />
    <Process />
    <Audience />
    <GetStarted />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
