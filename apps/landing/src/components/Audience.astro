---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).audience;
const avatarClass = ["a", "b", "c", "d", "a"];
const chipColor = ["#7aa2ff", "#ffb547", "#3ddc97", "#f08bd0", "#7aa2ff", "#ffb547"];
---

<section id="cho-ai">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
    </div>
    <div class="aud">
      <div class="card rv">
        <div class="pic" role="img" aria-label={t.solo.picAria}>
          <div class="people">
            {t.solo.avatars.map((a, i) => (
              <span class={`av ${avatarClass[i]}`} style={i === 0 ? "width:58px;height:58px;font-size:14px" : "width:44px;height:44px"}>{a}</span>
            ))}
          </div>
        </div>
        <div class="txt">
          <div class="tag">{t.solo.tag}</div>
          <h3>{t.solo.h3}</h3>
          <ul>
            {t.solo.items.map((x) => <li>{x}</li>)}
          </ul>
          <div class="btns"><a class="btn btn-primary" href="#dang-ky">{t.solo.btn}</a></div>
        </div>
      </div>
      <div class="card rv">
        <div class="pic" role="img" aria-label={t.biz.picAria}>
          <div class="team-chips">
            {t.biz.chips.map((c, i) => <span style={`background:${chipColor[i]}`}>{c}</span>)}
          </div>
        </div>
        <div class="txt">
          <div class="tag">{t.biz.tag}</div>
          <h3>{t.biz.h3}</h3>
          <ul>
            {t.biz.items.map((x) => <li>{x}</li>)}
          </ul>
          <div class="btns"><a class="btn btn-ghost" href="#dang-ky">{t.biz.btn}</a></div>
        </div>
      </div>
    </div>
  </div>
</section>
