---

<section id="xem-ben-trong">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">Bên trong một đội</div>
      <h2 style="margin-top:18px">Nhìn kỹ vào một đội.</h2>
      <p>Trưởng nhóm chia việc, người soạn làm bản nháp, các cổng kiểm tra soát lại. Chỉ khi qua hết, việc mới đến tay bạn. Đây là sáu đội mẫu.</p>
    </div>

    <div class="rv" data-slider>
      <div class="viewport">
        <div class="track" data-track>
          {teams.map((t, idx) => (
            <article class="slide" aria-label={`${idx + 1} / ${teams.length} · ${t.name}`}>
              <div class="stage">
                <div class="slide-head"><svg class="ic"><use href={`#${t.icon}`}></use></svg><div><h3 set:html={t.name} /><small>{t.caption}</small></div></div>
                <div class="org">
                  <div class="node lead" set:html={t.lead} />
                  <div class="link"></div>
                  <div class="row">
                    {t.steps.map((s) => <div class="node">{s}</div>)}
                  </div>
                  <div class="link"></div>
                  <div class="row">
                    {t.gates.map((g) => <div class="node gate">{g}</div>)}
                  </div>
                  <div class="link"></div>
                  <div class="node done">{t.done}</div>
                </div>
                <div class="guard">{t.guard}</div>
              </div>
              <div class="cap"><div><h3>{t.headline}</h3><p>{t.body}</p></div></div>
            </article>
          ))}
        </div>
      </div>

      <div class="controls">
        <button class="arrow" type="button" data-prev aria-label="Đội trước"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button class="arrow" type="button" data-next aria-label="Đội sau"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg></button>
        <div class="dots">
          {teams.map((t, idx) => (
            <button class="dot" type="button" data-dot aria-label={`Đội ${idx + 1}: ${t.name}`}></button>
          ))}
        </div>
        <span class="count" data-count>01 / 0{teams.length}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple carousel: one team per slide, auto-advances every 7 seconds, pauses on hover.
  // The track translates by whole slide widths, so slides are 100% wide.
  const slider = document.querySelector<HTMLElement>("[data-slider]");

  if (slider) {
    const track = slider.querySelector<HTMLElement>("[data-track]");
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const count = slider.querySelector<HTMLElement>("[data-count]");
    const prev = slider.querySelector<HTMLButtonElement>("[data-prev]");
    const next = slider.querySelector<HTMLButtonElement>("[data-next]");
    const total = dots.length;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      index = (n + total) % total;
      if (track) track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((dot, k) => {
        dot.classList.toggle("on", k === index);
        dot.setAttribute("aria-current", k === index ? "true" : "false");
      });
      if (count) count.textContent = `0${index + 1} / 0${total}`;
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!reduceMotion) timer = window.setInterval(() => show(index + 1), 7000);
    };

    prev?.addEventListener("click", () => { show(index - 1); start(); });
    next?.addEventListener("click", () => { show(index + 1); start(); });
    dots.forEach((dot, k) => dot.addEventListener("click", () => { show(k); start(); }));
    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);

    show(0);
    start();
  }
</script>
