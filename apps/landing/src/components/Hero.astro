---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).hero;
// The marquee repeats its group twice so the loop is seamless; the copy is hidden from assistive tech.
const groups = [false, true];
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="scanline" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow up" style="--d:.1s"><span class="live"></span>{t.eyebrow}</div>
      <p class="kick up" style="--d:.18s"><b>{t.kickBold}</b>{t.kickRest}</p>
      <h1 class="up" style="--d:.25s;margin-top:26px">{t.h1}</h1>
      <p class="bridge up" style="--d:.4s">{t.bridge}</p>
      <p class="lead up" style="--d:.55s">{t.lead}</p>
      <div class="btns up" style="--d:.7s">
        <a class="btn btn-primary" href="#nganh">{t.cta1}</a>
        <a class="btn btn-ghost" href="#bat-dau">{t.cta2}</a>
      </div>
    </div>

    <div class="up" style="--d:.4s;position:relative">
      <div class="wall" role="img" aria-label={t.wallAria}>
        <div class="wall-bar"><span>{t.wallTitle}</span><span>{t.wallStatus}</span></div>
        <div class="wall-grid">
          {t.tiles.map((tile) => (
            <div class={tile.hot ? "wt hot" : "wt"}>
              <svg class="ic"><use href={`#${tile.icon}`}></use></svg>
              <b>{tile.name}</b>
              <small><span class="d"></span>{tile.status}</small>
            </div>
          ))}
        </div>
      </div>
      <div class="wchip float" style="left:-22px;top:16%"><span class="av c"><svg class="ic" style="width:16px;height:16px;color:#05070a"><use href="#i-check"></use></svg></span><div>{t.chip1.title}<small>{t.chip1.sub}</small></div></div>
      <div class="wchip float" style="right:-16px;bottom:12%;animation-delay:-2.5s"><span class="av b">!</span><div>{t.chip2.title}<small>{t.chip2.sub}</small></div></div>
    </div>
  </div>

  <div class="wrap">
    <div class="stats">
      {t.stats.map((s) => <div class="stat rv"><b>{s.n}</b><span>{s.label}</span></div>)}
    </div>
  </div>

  <div class="marq" aria-label={t.marqAria}>
    <div class="marq-track">
      {groups.map((hidden) => (
        <div class="marq-group" aria-hidden={hidden ? "true" : undefined}>
          {t.pills.map((p) => <span class="pill"><svg class="ic"><use href={`#${p.icon}`}></use></svg>{p.label}</span>)}
        </div>
      ))}
    </div>
  </div>
</section>
