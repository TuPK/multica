---
import { getDict, type Lang } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).footer;
---

<footer>
  <div class="wrap row2">
    <div class="brand"><Logo /></div>
    <nav aria-label={t.navAria}>
      {t.items.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
    <div>{t.copyright}</div>
  </div>
</footer>
