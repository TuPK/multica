---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).software;
---

<section id="phan-mem">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>

    <div class="board rv" role="img" aria-label={t.boardAria}>
      {t.columns.map((c) => (
        <div class="col">
          <h4>{c.name}</h4>
          {c.cards.map((card) => (
            <div class={card.hot ? "kcard hot" : "kcard"}>{card.t}</div>
          ))}
        </div>
      ))}
    </div>
    <p class="board-cap rv">{t.caption}</p>

    <div class="mech3">
      {t.uses.map((u) => (
        <div class="card rv">
          <h3>{u.title}</h3>
          <p>{u.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
