---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).pricing;
const p = t.personal;
const b = t.business;
---

<section id="gia">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>
    <div class="prices">
      <div class="price rv">
        <div class="plan">{p.plan}</div>
        <div class="amt">{p.amount}<small>{p.per}</small></div>
        <div class="bill">
          <div><span>{p.quarter.label}</span><b>{p.quarter.price}</b><em>{p.quarter.save}</em></div>
          <div><span>{p.year.label}</span><b>{p.year.price}</b><em>{p.year.save}</em></div>
        </div>
        <ul>
          {p.items.map((x) => <li>{x}</li>)}
        </ul>
        <a class="btn btn-ghost" href="#dang-ky">{p.btn}</a>
      </div>
      <div class="price hi rv">
        <div class="plan">{b.plan}</div>
        <div class="amt">{b.amount}</div>
        <ul>
          {b.items.map((x) => <li>{x}</li>)}
        </ul>
        <a class="btn btn-primary" href="#dang-ky">{b.btn}</a>
      </div>
    </div>
  </div>
</section>
