---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).mechanics;
---

<section id="co-che">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
    </div>
    <div class="mech">
      {t.cards.map((c) => (
        <div class="card rv">
          <svg class="ic" viewBox="0 0 24 24" style="width:30px;height:30px;color:var(--accent)"><use href={`#${c.icon}`}></use></svg>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
