---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).industries;
---

<section id="nganh">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>

    <div class="ind">
      <a class="tile tile-feature rv" href="#phan-mem">
        <div class="tf-main">
          <svg class="ic"><use href="#i-code"></use></svg>
          <div>
            <h3>{t.feature.title}</h3>
            <p>{t.feature.text}</p>
          </div>
        </div>
        <span class="go">{t.feature.go}</span>
      </a>
      {t.tiles.map((tile) => (
        <div class="tile rv">
          <svg class="ic"><use href={`#${tile.icon}`}></use></svg>
          <h3>{tile.name}</h3>
          <p>{tile.text}</p>
        </div>
      ))}
      <div class="tile tile-wide rv">
        <div>
          <h3>{t.core.title}</h3>
          <p>{t.core.text}</p>
        </div>
        <div class="chips">
          {t.core.chips.map((c) => <span>{c}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
