---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).scenario;
---

<section id="kich-ban">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>

    <div class="steps5 rv">
      {t.steps.map((s, i) => (
        <div class="sstep">
          <div class="no">{t.stepLabel} {i + 1}</div>
          <div class="dept"><svg class="ic"><use href={`#${s.icon}`}></use></svg>{s.dept}</div>
          <p>{s.text}</p>
          <div class="to">{s.to}</div>
        </div>
      ))}
    </div>

    <p class="scenario-note rv"><em>{t.noteStrong}</em>{t.noteRest}</p>
  </div>
</section>
