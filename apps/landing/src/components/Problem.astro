---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).problem;
---

<section id="van-de">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>

    <div class="example rv">
      <div class="ex bad">
        <div class="lab">{t.badLabel}</div>
        <div class="big">{t.badBig}</div>
        <ul>
          {t.bad.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="ex good">
        <div class="lab">{t.goodLabel}</div>
        <div class="big">{t.goodBig}</div>
        <ul>
          {t.good.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>

    <p class="punch rv">{t.punch1} <em>{t.punch2}</em></p>
  </div>
</section>
