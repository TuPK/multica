---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).getStarted;
---

<section id="bat-dau">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>
    <div class="steps3 rv">
      {t.steps.map((s) => (
        <div class="sstep">
          <div class="no">{s.no}</div>
          <div class="dept"><svg class="ic"><use href={`#${s.icon}`}></use></svg>{s.title}</div>
          <p>{s.text}</p>
          <div class="to">{s.to}</div>
        </div>
      ))}
    </div>
  </div>
</section>
