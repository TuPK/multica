---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).process;
---

<section id="cach-lam">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="tag">{t.tag}</div>
      <h2 style="margin-top:18px">{t.h2}</h2>
      <p>{t.p}</p>
    </div>
    <div class="flow rv">
      {t.steps.map((s) => (
        <div class={s.gate ? "fs gate" : "fs"}>
          <div class="n"><svg class="ic"><use href={`#${s.icon}`}></use></svg></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>

    <div class="example rv">
      {t.examples.map((e) => (
        <div class="ex">
          <div class="lab">{e.label}</div>
          <div class="big">{e.big}</div>
          <div class="fig">{e.lines.map((l) => <div>{l.k}: <b>{l.v}</b></div>)}</div>
          <p>{e.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
