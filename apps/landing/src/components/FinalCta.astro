---
import { getDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).finalCta;
---

<section id="dang-ky" class="final" style="border-top:1px solid var(--line)">
  <div class="ring" aria-hidden="true"></div>
  <div class="ring r2" aria-hidden="true"></div>
  <div class="ring r3" aria-hidden="true"></div>
  <div class="wrap" style="position:relative">
    <h2 class="rv">{t.h2}</h2>
    <p class="rv">{t.p}</p>
    <div class="btns rv">
      <a class="btn btn-primary" href="#nganh">{t.btn1}</a>
      <a class="btn btn-ghost" href="#cho-ai">{t.btn2}</a>
    </div>
  </div>
</section>
