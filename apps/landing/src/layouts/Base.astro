---
import "../styles/landing.css";
import { getDict, pathFor, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  // Optional overrides for pages other than the home page.
  title?: string;
  description?: string;
}

const { lang, title = undefined, description = undefined } = Astro.props;
const { meta, htmlLang } = getDict(lang);
const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    <link rel="alternate" hreflang="vi" href={pathFor("vi")} />
    <link rel="alternate" hreflang="en" href={pathFor("en")} />
    <link rel="alternate" hreflang="x-default" href={pathFor("vi")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash. Default is dark.
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
      } catch (e) {}
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="mc">
    <slot />
  </body>
</html>
