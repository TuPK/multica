{
  "version": 2,
  "start": "plan",
  "roles": [
    {
      "key": "worker",
      "kind": "agent",
      "pool": 4
    }
  ],
  "stops": [
    {
      "code": "loop_exhausted",
      "class": "loop_exhausted",
      "message": "stop3",
      "legacy_no": 3
    }
  ],
  "terminals": [
    {
      "key": "done",
      "status": "done"
    },
    {
      "key": "cancelled",
      "status": "cancelled"
    }
  ],
  "steps": [
    {
      "key": "plan",
      "kind": "lead",
      "status": {
        "key": "todo"
      },
      "title": "Plan",
      "lead": {
        "sets": [
          "items"
        ]
      },
      "edges": [
        {
          "id": "plan_ok",
          "label": "Planned",
          "to": "work"
        }
      ]
    },
    {
      "key": "work",
      "kind": "tasks",
      "status": {
        "key": "in_progress"
      },
      "tasks": [
        {
          "key": "item",
          "title": "One per item",
          "kind": "work",
          "role": "worker",
          "instances": {
            "from_var": "items",
            "min": 1,
            "max": 4,
            "distinct": true
          }
        }
      ],
      "title": "Work",
      "edges": [
        {
          "id": "work_next",
          "label": "Done",
          "to": "done"
        }
      ]
    }
  ],
  "messages": {
    "stop3": "BLOCKED · stop 3\n{requester} {request} stopped at {step}.\n{tasks}"
  },
  "policy": {},
  "vars": [
    {
      "key": "items",
      "type": "list_string",
      "max_items": 6,
      "default": [
        "x"
      ],
      "set_by": [
        "lead"
      ],
      "set_at": [
        "plan"
      ]
    }
  ]
}
