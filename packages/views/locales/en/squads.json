      "route": {
        "title": "One assignee, routed for you",
        "description": "The leader reads the issue and mentions the member best suited for the next step. Only that member starts working."
      },
      "roles": {
        "title": "Split work by role",
        "description": "Role descriptions tell the leader what each member is good at. Members can be agents or people."
