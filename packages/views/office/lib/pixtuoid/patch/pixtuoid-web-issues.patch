+/// The studio floor's desk count: 4 in each of two rooms and 4 in a row in the open.
+pub(crate) const STUDIO_DESKS: usize = 12;
+/// The smallest buffer the studio floor lays out in.
+const STUDIO_MIN_W: u16 = 220;
+const STUDIO_MIN_H: u16 = 150;
+/// The studio's left column, narrower than the standard floor's so the desk rooms have the width.
+const STUDIO_MID_X_PCT: u16 = 20;
+/// A desk room's interior, walls to walls: a 2x2 pod and its aisles.
+const STUDIO_ROOM_W: u16 = 60;
+const STUDIO_ROOM_H: u16 = 42;
+const STUDIO_ROOM_GAP: u16 = 18;
+/// How far below the wall band the rooms start, clear of the lounge's couch.
+const STUDIO_ROOMS_BELOW_TOP: u16 = 22;
+/// The open row's desks are this far apart, edge to edge.
+const STUDIO_ROW_GAP_X: u16 = 22;
+/// The open row sits this far below the rooms' south walls.
+const STUDIO_ROW_BELOW_ROOMS: u16 = 14;
+
+/// The two desk rooms, side by side under the lounge, centred in the band.
+fn studio_rooms(band: &Bounds, top_margin: u16) -> Vec<Bounds> {
+    let total = 2 * STUDIO_ROOM_W + STUDIO_ROOM_GAP;
+    let x0 = band.x + band.width.saturating_sub(total) / 2;
+    let y = top_margin + STUDIO_ROOMS_BELOW_TOP;
+    (0..2)
+        .map(|i| Bounds {
+            x: x0 + i * (STUDIO_ROOM_W + STUDIO_ROOM_GAP),
+            y,
+            width: STUDIO_ROOM_W,
+            height: STUDIO_ROOM_H,
+        })
+        .collect()
+}
+
+/// The studio's twelve desks: a 2x2 pod centred in each desk room, then a row of four
+/// in the open below, all facing south.
+fn studio_desks(plan: &FloorPlan) -> Vec<HomeDesk> {
+    let mut desks = Vec::with_capacity(STUDIO_DESKS);
+    for room in &plan.desk_rooms {
+        let pod_w = POD_SIDE * DESK_W + (POD_SIDE - 1) * INTRA_POD_GAP_X;
+        let pod_h = POD_SIDE * DESK_H + (POD_SIDE - 1) * INTRA_POD_GAP_Y;
+        let ox = room.x + room.width.saturating_sub(pod_w) / 2;
+        let oy = room.y + room.height.saturating_sub(pod_h) / 2;
+        for r in 0..POD_SIDE {
+            for c in 0..POD_SIDE {
+                desks.push(HomeDesk {
+                    at: Point {
+                        x: ox + c * (DESK_W + INTRA_POD_GAP_X),
+                        y: oy + r * (DESK_H + INTRA_POD_GAP_Y),
+                    },
+                    facing: pod_row_facing(r),
+                });
+            }
+        }
+    }
+    let band = plan.pod_grid.band;
+    let row_w = 4 * DESK_W + 3 * STUDIO_ROW_GAP_X;
+    let x0 = band.x + band.width.saturating_sub(row_w) / 2;
+    let rooms_south = plan
+        .desk_rooms
+        .first()
+        .map_or(band.y, |room| room.y + room.height);
+    let y = rooms_south + STUDIO_ROW_BELOW_ROOMS;
+    for i in 0..4 {
+        desks.push(HomeDesk {
+            at: Point {
+                x: x0 + i * (DESK_W + STUDIO_ROW_GAP_X),
+                y,
+            },
+            facing: Facing::South,
+        });
+    }
+    desks
+}
