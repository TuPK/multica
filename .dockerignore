# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Dockerfile.web needs the web workspace and root dependency patch inputs.
# Dockerfile.landing needs the landing workspace.
# Default-exclude other app files so they do not enter the build context.
/apps/*
!/apps/web/
!/apps/landing/
!/apps/mobile
/apps/mobile/*
!/apps/mobile/patches
!/apps/mobile/patches/**

# Repository-only tooling
/.github/
/deploy/
/scripts/*
# The image builds run the catalog generator (Dockerfile "catalog" stage, Dockerfile.web).
!/scripts/catalog
!/scripts/lib
!/scripts/generate-kitviet-pack.mjs

# Generated by `pnpm catalog:build` inside the image build; a local copy must never leak in.
packages/core/catalog/generated
server/internal/catalog/generated/*.json
