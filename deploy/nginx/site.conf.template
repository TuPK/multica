# TLS site, rendered by entrypoint.sh once certbot has written the certificate.
# ${TLS_DOMAIN}           -> landing page
# app.${TLS_DOMAIN}       -> web app, with the backend's API and WebSocket paths sent to the backend
# platform.${TLS_DOMAIN}  -> platform management console
# See deploy/nginx/README.md for the design.

# Docker's embedded DNS. Upstreams are variables, so nginx resolves them per request
# and starts even while a service is still booting or restarting.
resolver 127.0.0.11 valid=30s ipv6=off;

# WebSocket upgrades keep the connection open; ordinary requests send "Connection: close".
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# Plain HTTP answers the ACME challenge and redirects everything else to HTTPS.
server {
  listen 80;
  listen [::]:80;
  server_name ${TLS_DOMAIN} app.${TLS_DOMAIN} platform.${TLS_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# Unknown host names get no response.
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
  return 444;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${TLS_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    set $landing http://landing:80;
    proxy_pass $landing;
    include /etc/nginx/deploy/proxy-headers.conf;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name app.${TLS_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;
  add_header Strict-Transport-Security "max-age=31536000" always;

  # Attachment uploads. The backend's own limits still apply.
  client_max_body_size 50m;

  # The backend's routes, sent straight to the backend. This list mirrors
  # runtimeRewriteDestination in apps/web/config/runtime-urls.ts, except that the
  # WebSocket paths (/ws, /collab, /api/daemon/ws) must not go through the Next.js
  # runtime proxy, which rewrites plain HTTP only.
  location ~ ^/(api|v1)/ {
    include /etc/nginx/deploy/backend-proxy.conf;
  }

  location = /ws {
    include /etc/nginx/deploy/backend-proxy.conf;
  }

  location = /collab {
    include /etc/nginx/deploy/backend-proxy.conf;
  }

  location = /health {
    include /etc/nginx/deploy/backend-proxy.conf;
  }

  # Auth endpoints, except the OAuth callbacks that the web app serves itself.
  location ~ ^/auth/(?!callback(/|$)|hg-sso/callback(/|$)) {
    include /etc/nginx/deploy/backend-proxy.conf;
  }

  # Everything else is the Next.js web app.
  location / {
    set $frontend http://frontend:3000;
    proxy_pass $frontend;
    include /etc/nginx/deploy/proxy-headers.conf;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name platform.${TLS_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${TLS_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_DOMAIN}/privkey.pem;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    set $platform http://platform:30001;
    proxy_pass $platform;
    include /etc/nginx/deploy/proxy-headers.conf;
  }
}
