# Used until certbot has written the certificate. Answers only the ACME HTTP-01
# challenge; entrypoint.sh switches to site.conf.template once the certificate exists.

server {
  listen 80;
  listen [::]:80;
  server_name ${TLS_DOMAIN} app.${TLS_DOMAIN} platform.${TLS_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 503;
  }
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  return 444;
}
