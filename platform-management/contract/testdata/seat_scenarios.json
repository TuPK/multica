  {
   "name": "overcommit_is_409",
   "rules": [
    3
   ],
   "steps": [
    {
     "world": {
      "subscription": true,
      "purchased": 2,
      "members": 3,
      "version": 5
     }
    },
    {
     "clock": "2026-08-15T10:00:00Z"
    },
    {
     "call": "reserve",
     "token": "00000000-0000-4000-8000-000000000001",
     "expires_at": "2026-08-15T10:10:00Z",
     "name": "reserve",
     "expect": {
      "status": 409,
      "code": "capacity_overcommitted"
     }
    },
    {
     "call": "claim",
     "token": "00000000-0000-4000-8000-000000000002",
     "name": "claim",
     "expect": {
      "status": 409,
      "code": "capacity_overcommitted"
     }
    },
    {
     "call": "release",
     "token": "00000000-0000-4000-8000-000000000001",
     "name": "release still works",
     "expect": {
      "managed": true,
      "allowed": false,
      "reason": "released"
     }
    },
    {
     "world": {
      "subscription": true,
      "purchased": 3,
      "members": 3,
      "version": 5
     }
    },
    {
     "call": "reserve",
     "token": "00000000-0000-4000-8000-000000000001",
     "expires_at": "2026-08-15T10:10:00Z",
     "name": "full is not overcommitted",
     "expect": {
      "managed": true,
      "allowed": false,
      "reason": "capacity_full",
      "purchased": 3,
      "used": 3,
      "reserved": 0,
      "version": 5
     }
    }
   ]
