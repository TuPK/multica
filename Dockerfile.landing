# Marketing landing page (apps/landing). Astro builds static files, and nginx serves them.
# The container listens on 80; docker-compose.selfhost.yml publishes it on LANDING_PORT
# (default 30002), next to the web app on FRONTEND_PORT.

FROM node:22.23.4-alpine AS builder

WORKDIR /app

# Activate the pnpm version pinned in package.json, as Dockerfile.web does.
COPY package.json ./
RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate

# Root manifests, the lockfile, and the root patch inputs. Only the landing workspace is installed.
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/mobile/patches/ apps/mobile/patches/
COPY apps/landing/ apps/landing/
RUN pnpm install --frozen-lockfile --filter @multica/landing...

RUN pnpm --filter @multica/landing build

# --- Runtime ---
FROM nginx:1.27-alpine AS runner

COPY apps/landing/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/landing/dist /usr/share/nginx/html

EXPOSE 80
